{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Icaro0310/devin-orchestrator/plan.schema.json",
  "title": "devin-orchestrator worker plan",
  "type": "object",
  "required": ["workers", "mode", "profiles", "rationale", "collect", "nesting_blocked", "warnings", "limits"],
  "properties": {
    "workers": {"type": "integer", "minimum": 0},
    "mode": {"type": "string", "enum": ["none", "background"]},
    "profiles": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "collect": {"type": "boolean"},
    "nesting_blocked": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "file_collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["units", "path"],
        "properties": {
          "units": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "path": {"type": "string"}
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_workers", "nesting"],
      "properties": {
        "max_workers": {"type": "integer"},
        "nesting": {"type": "string"}
      }
    },
    "signals": {
      "type": "object",
      "description": "Machine signals collected by signals.collect_signals at plan time (ram_pressure, inside_worker, ram_*_mb). A null ram_pressure means the host could not be measured, not that it is healthy.",
      "properties": {
        "inside_worker": {"type": "boolean"},
        "ram_total_mb": {"type": ["integer", "null"]},
        "ram_available_mb": {"type": ["integer", "null"]},
        "ram_pressure": {"type": ["boolean", "null"]}
      }
    },
    "units": {
      "type": "array",
      "description": "Present with `plan --from-triggers` (enabled trigger manifests resolved into DAG order via `after` + `requires.artifacts` edges; 'after' lists resolved dependencies inside the unit set) and with `plan --files` (one unit per declared file; 'files' carries the constrained path, 'event'/'after' stay empty). Manifest action commands are never propagated — units are data only.",
      "items": {
        "type": "object",
        "required": ["id", "event", "after"],
        "properties": {
          "id": {"type": "string"},
          "event": {"type": ["string", "null"]},
          "after": {"type": "array", "items": {"type": "string"}},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "description": "Present only with --cost-estimate: per-unit duration estimate in minutes (planning label, not billing).",
      "properties": {
        "unit": {"type": "string"},
        "unit_count": {"type": "integer"},
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "est_minutes"],
            "properties": {
              "id": {"type": "string"},
              "est_minutes": {"type": "number"}
            }
          }
        },
        "planned_workers": {"type": "integer"},
        "estimated_sessions": {"type": "integer"},
        "sequential_minutes": {"type": "number"},
        "fanout_minutes": {"type": "number"},
        "speedup": {"type": "number"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}
